{
  "expo": {
    "name": "Real Estate App",
    "slug": "real_estate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maknova.real_estate"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1628",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.maknova.real_estate",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Real Estate App to scan visitor QR passes and capture live plot photos for verification."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10B981",
          "defaultChannel": "estateflow"
        }
      ],
      "expo-sharing",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "b2f110dd-2be2-4993-99e1-ecc96fbe64e0"
      }
    }
  }
}
