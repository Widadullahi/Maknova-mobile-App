# Separate staging configuration; read README.md before running.
AWS_REGION=eu-west-1
AWS_PROFILE=maknova-staging
STAGING_DYNAMODB_TABLE=maknova-staging-migration
# Use a unique, random secret of at least 32 characters; never commit the value.
STAGING_JWT_SECRET=
# Set the separate staging frontend origin; never use * for production.
STAGING_CORS_ORIGINS=http://127.0.0.1:8082
