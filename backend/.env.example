FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=real_estate
MYSQL_PASSWORD=real_estate
MYSQL_DATABASE=real_estate
# Managed-MySQL TLS: set MYSQL_SSL_CA to the provider CA cert path (Aiven/RDS/etc).
# Leave empty for local/VPS dev (no TLS). See docs/DATABASE_MIGRATION_AIVEN.md.
MYSQL_SSL_CA=
MYSQL_SSL_VERIFY_IDENTITY=false
CORS_ORIGINS=*
RUN_MIGRATIONS_ON_STARTUP=true
SEED_DEFAULT_ROLE_ACCOUNTS=true
# Demo logins (demo@estate.com / demo1234). NEVER enable in production — set
# true only in local/demo environments that need the seeded demo identities.
DEMO_LOGIN_ENABLED=false
# Expo push service. Set false in local dev to skip outbound push calls.
EXPO_PUSH_ENABLED=true
UPLOAD_DIR=uploads
